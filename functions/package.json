{
  "name": "functions",
  "scripts": {
    "lint": "eslint '**/*.ts'",
    "lint:fix": "eslint '**/*.ts' --fix",
    "prettier": "prettier -c .",
    "prettier:fix": "prettier --write .",
    "build": "tsc --build tsconfig.build.json --verbose",
    "serve": "npm run build && firebase serve --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "c8 --reporter=html --reporter=text ava --verbose"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@types/luxon": "^3.7.1",
    "@types/uuid": "^11.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.0",
    "luxon": "^3.7.2",
    "typescript": "^6.0.3",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@ava/typescript": "^7.0.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/sinon": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "ava": "^8.0.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "firebase-functions-test": "^3.5.0",
    "google-gax": "^5.0.8",
    "nodemon": "^3.1.14",
    "c8": "^12.0.0",
    "prettier": "^3.8.4",
    "sinon": "^22.1.0",
    "ts-node": "^10.9.2",
    "tslint": "^6.1.3"
  },
  "overrides": {
    "fast-xml-parser": ">=5.3.8",
    "tar": "^7.5.18",
    "@google-cloud/firestore": {
      "uuid": "^11.1.1"
    },
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "teeny-request": {
      "uuid": "^11.1.1"
    }
  },
  "private": true,
  "ava": {
    "typescript": {
      "compile": "tsc",
      "rewritePaths": {
        "__tests__/": "lib_test/__tests__/"
      }
    }
  }
}